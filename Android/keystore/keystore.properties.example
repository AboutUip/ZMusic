# 发行签名配置模版（可提交）
# 复制为本目录下的 keystore.properties，填入真实值后再打 release 包。
# keystore.properties 与 *.jks / *.keystore 已被 .gitignore，请勿提交私钥。
#
# 未配置时，release 构建默认使用 debug 签名（开源克隆即可编译安装）。

# 相对 Android/ 工程根目录的密钥库路径
storeFile=keystore/ZMusic-release.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
