<UserControl x:Class="ZMusic.Views.Controls.NowPlayingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:ZMusic.Views.Controls"
             xmlns:conv="clr-namespace:ZMusic.Converters"
             xmlns:vm="clr-namespace:ZMusic.ViewModels"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Visibility="Collapsed"
             Opacity="0"
             Background="#FF000000">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

            <Style x:Key="DismissButton" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InkIconButton" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InkPlayButton" TargetType="Button">
                <Setter Property="Width" Value="68" />
                <Setter Property="Height" Value="68" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Width="68"
                                    Height="68"
                                    CornerRadius="34"
                                    Background="#FFFFFFFF">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6E6E6" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#CCCCCC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Seek: press/drag only (no hover-follow) -->
            <Style x:Key="InkSeekSlider" TargetType="Slider">
                <Setter Property="Height" Value="28" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="IsSnapToTickEnabled" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Border Height="4"
                                        CornerRadius="2"
                                        Background="#33FFFFFF"
                                        VerticalAlignment="Center" />
                                <Border x:Name="TrackFill"
                                        Height="4"
                                        CornerRadius="2"
                                        Background="#FFFFFFFF"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Width="0" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Style="{x:Null}"
                                                      Opacity="0"
                                                      Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Style="{x:Null}"
                                                      Opacity="0"
                                                      Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="16" Height="16" Fill="#FFFFFFFF" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LyricLineButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" ClipToBounds="True" Background="#F2000000">
        <!-- Frosted veil: blocks page bleed; cover tint is atmosphere only -->
        <Border Background="#E608080C" />

        <Grid IsHitTestVisible="False">
            <ctrl:UrlImage x:Name="BackdropImage"
                           Url="{Binding CoverUrl}"
                           DecodePixelWidth="960"
                           Stretch="UniformToFill"
                           Opacity="0.22"
                           Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                <ctrl:UrlImage.Effect>
                    <BlurEffect Radius="90" KernelType="Gaussian" />
                </ctrl:UrlImage.Effect>
                <ctrl:UrlImage.RenderTransform>
                    <ScaleTransform x:Name="BackdropScale" ScaleX="1.04" ScaleY="1.04"
                                    CenterX="0.5" CenterY="0.5" />
                </ctrl:UrlImage.RenderTransform>
                <ctrl:UrlImage.RenderTransformOrigin>0.5,0.5</ctrl:UrlImage.RenderTransformOrigin>
            </ctrl:UrlImage>
            <Border Background="#99000000" />
        </Grid>

        <Grid Margin="0,36,0,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="ChromeHost"
                    Grid.Row="0"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ChromeSlide" Y="-12" />
                </Border.RenderTransform>
                <Button HorizontalAlignment="Center"
                        Style="{StaticResource DismissButton}"
                        Click="OnDismissClick"
                        ToolTip="收起">
                    <ui:SymbolIcon Symbol="ChevronDown24"
                                   FontSize="18"
                                   Foreground="#CCFFFFFF" />
                </Button>
            </Border>

            <Grid x:Name="BodyGrid" Grid.Row="1" Margin="40,4,32,0">
                <Grid.ColumnDefinitions>
                    <!-- Slightly wider than original 40/60 -->
                    <ColumnDefinition Width="9*" MinWidth="240" />
                    <ColumnDefinition Width="11*" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: cover + controls as one group, vertically centered -->
                <Grid x:Name="StageHost"
                      Grid.Column="0"
                      Margin="4,0,24,0"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Opacity="0"
                      ClipToBounds="True"
                      RenderTransformOrigin="0.5,0.55">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="StageScale" ScaleX="0.94" ScaleY="0.94" />
                            <TranslateTransform x:Name="StageSlide" Y="28" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Whole block scales down together when short; stays vertically centered -->
                    <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             MaxWidth="480">
                        <StackPanel x:Name="StageColumn" Width="420">
                            <Grid x:Name="CoverHost"
                                  Width="420"
                                  Height="420"
                                  Margin="0,0,0,18"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="CoverSlide" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Border CornerRadius="16" Background="#1AFFFFFF">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="40"
                                                          ShadowDepth="10"
                                                          Opacity="0.45"
                                                          Color="#000000"
                                                          Direction="270" />
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="16" ClipToBounds="True" Background="#141414">
                                    <Grid>
                                        <TextBlock Text="♪"
                                                   FontSize="64"
                                                   Foreground="#66FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasCover, Converter={StaticResource InvBoolToVis}}" />
                                        <ctrl:UrlImage x:Name="CoverImage"
                                                       Url="{Binding CoverUrl}"
                                                       DecodePixelWidth="800"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="MetaHost"
                                        Margin="0,0,0,12"
                                        RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="MetaSlide" Y="0" />
                                </StackPanel.RenderTransform>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Artists}"
                                           FontSize="14"
                                           Foreground="#99FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>

                            <Grid Margin="0,0,0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Slider x:Name="SeekBar"
                                        Style="{StaticResource InkSeekSlider}"
                                        Value="{Binding Progress, Mode=OneWay}"
                                        ValueChanged="OnSeekValueChanged" />
                                <Grid Grid.Row="1" Margin="2,2,2,0">
                                    <TextBlock Text="{Binding PositionText}"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               Foreground="#88FFFFFF"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding DurationText}"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               Foreground="#55FFFFFF"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0,10,0,0" Height="68">
                                <Button HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource InkIconButton}"
                                        Command="{Binding CycleModeCommand}"
                                        ToolTip="{Binding ModeLabel}">
                                    <Grid Width="20" Height="20">
                                        <ui:SymbolIcon x:Name="ModeOrderIcon"
                                                       Symbol="ArrowRepeatAll24"
                                                       FontSize="18"
                                                       Foreground="#CCFFFFFF"
                                                       Visibility="Visible" />
                                        <ui:SymbolIcon x:Name="ModeOneIcon"
                                                       Symbol="ArrowRepeat124"
                                                       FontSize="18"
                                                       Foreground="#CCFFFFFF"
                                                       Visibility="Collapsed" />
                                        <ui:SymbolIcon x:Name="ModeShuffleIcon"
                                                       Symbol="ArrowShuffle24"
                                                       FontSize="18"
                                                       Foreground="#CCFFFFFF"
                                                       Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource InkIconButton}"
                                            Command="{Binding SkipPreviousCommand}"
                                            ToolTip="上一首"
                                            Margin="0,0,8,0">
                                        <ui:SymbolIcon Symbol="Previous24"
                                                       FontSize="22"
                                                       Foreground="#FFFFFFFF" />
                                    </Button>
                                    <Button Style="{StaticResource InkPlayButton}"
                                            Command="{Binding TogglePlayPauseCommand}"
                                            ToolTip="播放 / 暂停">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Play24"
                                                           FontSize="24"
                                                           Foreground="#FF000000"
                                                           Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolToVis}}" />
                                            <ui:SymbolIcon Symbol="Pause24"
                                                           FontSize="24"
                                                           Foreground="#FF000000"
                                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource InkIconButton}"
                                            Command="{Binding SkipNextCommand}"
                                            ToolTip="下一首"
                                            Margin="8,0,0,0">
                                        <ui:SymbolIcon Symbol="Next24"
                                                       FontSize="22"
                                                       Foreground="#FFFFFFFF" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Viewbox>
                </Grid>

                <!-- RIGHT 60%: lyrics -->
                <Grid x:Name="LyricHost"
                      Grid.Column="1"
                      Opacity="0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="LyricSlide" X="36" />
                    </Grid.RenderTransform>

                    <TextBlock Text="{Binding LyricEmptyHint}"
                               FontSize="16"
                               Foreground="#55FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding HasLyrics, Converter={StaticResource InvBoolToVis}}" />

                    <ScrollViewer x:Name="LyricScroller"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  PreviewMouseWheel="OnLyricMouseWheel"
                                  Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVis}}">
                        <ItemsControl x:Name="LyricList"
                                      ItemsSource="{Binding LyricLines}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LyricLineItem}">
                                    <Button Style="{StaticResource LyricLineButton}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.SeekToLyricCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Opacity="0.28"
                                            RenderTransformOrigin="0.5,0.5"
                                            Loaded="OnLyricLineLoaded">
                                        <Button.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <TranslateTransform Y="0" />
                                            </TransformGroup>
                                        </Button.RenderTransform>
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="22"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   LineHeight="32"
                                                   MaxWidth="480"
                                                   Foreground="#FFFFFFFF"
                                                   HorizontalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
