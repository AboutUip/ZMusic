<UserControl x:Class="ZMusic.Views.Controls.MiniPlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:ZMusic.Views.Controls"
             xmlns:conv="clr-namespace:ZMusic.Converters"
             Focusable="False"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="InkIconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkPlayButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{ui:ThemeResource TextFillColorPrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InkProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Height="3"
                                    CornerRadius="1.5"
                                    Background="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />
                            <Border x:Name="PART_Indicator"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    CornerRadius="1.5"
                                    Background="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root"
          RenderTransformOrigin="0.5,1"
          Cursor="Hand">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="16" />
        </Grid.RenderTransform>

        <Border x:Name="Card"
                Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Opacity="0"
                Cursor="Hand"
                MouseLeftButtonUp="OnCardClick">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,12,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                IsHitTestVisible="False">
                            <Grid>
                                <TextBlock Text="♪"
                                           FontSize="16"
                                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasCover, Converter={StaticResource InvBoolToVis}}" />
                                <ctrl:UrlImage Url="{Binding CoverUrl}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    MaxWidth="280"
                                    IsHitTestVisible="False">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding Artists}"
                                       FontSize="11"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource InkIconButton}"
                                Command="{Binding SkipPreviousCommand}"
                                ToolTip="上一首"
                                Margin="0,0,4,0">
                            <ui:SymbolIcon Symbol="Previous24"
                                           FontSize="15"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource InkPlayButton}"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip="播放 / 暂停"
                                Margin="4,0">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24"
                                               FontSize="15"
                                               Foreground="{ui:ThemeResource ApplicationBackgroundBrush}"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolToVis}}" />
                                <ui:SymbolIcon Symbol="Pause24"
                                               FontSize="15"
                                               Foreground="{ui:ThemeResource ApplicationBackgroundBrush}"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource InkIconButton}"
                                Command="{Binding SkipNextCommand}"
                                ToolTip="下一首"
                                Margin="4,0,8,0">
                            <ui:SymbolIcon Symbol="Next24"
                                           FontSize="15"
                                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource InkIconButton}"
                                Command="{Binding CycleModeCommand}"
                                ToolTip="{Binding ModeLabel}">
                            <Grid Width="16" Height="16">
                                <ui:SymbolIcon x:Name="ModeOrderIcon"
                                               Symbol="ArrowRepeatAll24"
                                               FontSize="14"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="Visible" />
                                <ui:SymbolIcon x:Name="ModeOneIcon"
                                               Symbol="ArrowRepeat124"
                                               FontSize="14"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="Collapsed" />
                                <ui:SymbolIcon x:Name="ModeShuffleIcon"
                                               Symbol="ArrowShuffle24"
                                               FontSize="14"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="{Binding PositionText}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" / "
                                   FontSize="11"
                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DurationText}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0" IsHitTestVisible="False">
                    <ProgressBar Style="{StaticResource InkProgress}"
                                 Value="{Binding Progress, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
