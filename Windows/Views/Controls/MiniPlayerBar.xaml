<UserControl x:Class="ZMusic.Views.Controls.MiniPlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:ZMusic.Views.Controls"
             xmlns:conv="clr-namespace:ZMusic.Converters"
             Focusable="False"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="TransportIconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ink primary control: white disc + black glyph -->
        <Style x:Key="PlayPauseButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#F2FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.35"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress: ink rail + ink fill (no accent) -->
        <Style x:Key="ReadOnlyProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#28FFFFFF" />
                            <Border x:Name="PART_Indicator"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="#E6FFFFFF"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root"
          Margin="12,0,12,10"
          RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="16" />
        </Grid.RenderTransform>

        <Border x:Name="Card"
                Background="#66000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,12"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="0"
                                  Opacity="0.28"
                                  Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,12,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="44"
                                Height="44"
                                CornerRadius="10"
                                ClipToBounds="True"
                                Background="#1AFFFFFF">
                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#33FFFFFF" Offset="0" />
                                            <GradientStop Color="#14FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="♪"
                                           FontSize="16"
                                           Foreground="#99FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasCover, Converter={StaticResource InvBoolToVis}}" />
                                <ctrl:UrlImage Url="{Binding CoverUrl}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    MaxWidth="280">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding Artists}"
                                       FontSize="11"
                                       Foreground="#88FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource TransportIconButton}"
                                Command="{Binding CycleModeCommand}"
                                ToolTip="{Binding ModeLabel}"
                                Margin="0,0,8,0">
                            <Grid Width="18" Height="18">
                                <ui:SymbolIcon x:Name="ModeOrderIcon"
                                               Symbol="ArrowRepeatAll24"
                                               FontSize="15"
                                               Foreground="#C8FFFFFF"
                                               Visibility="Visible" />
                                <ui:SymbolIcon x:Name="ModeOneIcon"
                                               Symbol="ArrowRepeat124"
                                               FontSize="15"
                                               Foreground="#C8FFFFFF"
                                               Visibility="Collapsed" />
                                <ui:SymbolIcon x:Name="ModeShuffleIcon"
                                               Symbol="ArrowShuffle24"
                                               FontSize="15"
                                               Foreground="#C8FFFFFF"
                                               Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource PlayPauseButton}"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip="播放 / 暂停">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24"
                                               FontSize="16"
                                               Foreground="#FF0A0A0A"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolToVis}}" />
                                <ui:SymbolIcon Symbol="Pause24"
                                               FontSize="16"
                                               Foreground="#FF0A0A0A"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding PositionText}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="#AAFFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" / "
                                   FontSize="11"
                                   Foreground="#55FFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DurationText}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="#77FFFFFF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <ProgressBar Style="{StaticResource ReadOnlyProgress}"
                                 Value="{Binding Progress, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
