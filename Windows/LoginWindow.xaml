<ui:FluentWindow x:Class="ZMusic.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:ZMusic.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
                 Title="ZMusic"
                 Width="920"
                 Height="580"
                 MinWidth="820"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 Background="Transparent"
                 Icon="pack://application:,,,/Assets/app-icon.png">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ModeChip" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeChipActive" TargetType="Button" BasedOn="{StaticResource ModeChip}">
            <Setter Property="Background" Value="#22B8FF4A" />
            <Setter Property="Foreground" Value="#FFF4FFE8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GhostField" TargetType="TextBox">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="CaretBrush" Value="#B8FF4A" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftAction" TargetType="Button">
            <Setter Property="Background" Value="#59000000" />
            <Setter Property="Foreground" Value="#EEFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#80000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Foreground" Value="#FF0B0B0B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#B8FF4A" Offset="0" />
                                    <GradientStop Color="#FFF066" Offset="0.5" />
                                    <GradientStop Color="#5CE1FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dark Acrylic tint layer -->
        <Border Grid.RowSpan="2" Background="#B208080C" IsHitTestVisible="False" />

        <ui:TitleBar Grid.Row="0"
                     Title="ZMusic"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/app-icon.png'}" />

        <Grid x:Name="RootContent"
              Grid.Row="1"
              Margin="36,8,36,36"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform Y="16" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Brand column -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,0,0,24">
                <TextBlock FontSize="42"
                           FontWeight="SemiBold"
                           FontStyle="Italic"
                           Text="ZMusic">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C8FF5A" Offset="0" />
                            <GradientStop Color="#FFF066" Offset="0.45" />
                            <GradientStop Color="#5CE1FF" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Margin="0,14,24,0"
                           FontSize="16"
                           LineHeight="26"
                           Foreground="#B8FFFFFF"
                           Text="扫一扫，或用手机号继续听。&#x0a;把世界调小一点。"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Dark glass card -->
            <Border Grid.Column="2"
                    Background="#73000000"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#59000000"
                            CornerRadius="12"
                            Padding="4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="QrModeButton"
                                    Content="扫码登录"
                                    Command="{Binding SelectQrCommand}"
                                    Style="{StaticResource ModeChip}" />
                            <Button x:Name="PhoneModeButton"
                                    Content="手机号登录"
                                    Command="{Binding SelectPhoneCommand}"
                                    Style="{StaticResource ModeChip}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Background="#22FF6B6B"
                            CornerRadius="10"
                            Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BannerError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BannerError}"
                                   Foreground="#FFFFD7D7"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Panels -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid x:Name="QrPanel" Opacity="1">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Phone">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border x:Name="QrGlow"
                                        Width="228"
                                        Height="228"
                                        CornerRadius="20"
                                        Background="#80000000"
                                        BorderBrush="#55B8FF4A"
                                        BorderThickness="1"
                                        Padding="14">
                                    <Grid>
                                        <Image Source="{Binding QrImage}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Background="#B2000000"
                                                CornerRadius="12"
                                                Visibility="{Binding QrExpired, Converter={StaticResource BoolToVis}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="已过期"
                                                           Foreground="#EEFFFFFF"
                                                           FontSize="15"
                                                           HorizontalAlignment="Center" />
                                                <Button Margin="0,12,0,0"
                                                        Content="刷新二维码"
                                                        Command="{Binding RefreshQrCommand}"
                                                        Style="{StaticResource SoftAction}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,18,0,0"
                                           Text="{Binding QrHint}"
                                           Foreground="#B3FFFFFF"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PhonePanel">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Phone">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel VerticalAlignment="Center" MaxWidth="360">
                                <TextBlock Text="手机号"
                                           Foreground="#88FFFFFF"
                                           FontSize="12"
                                           Margin="4,0,0,8" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GhostField}"
                                         MaxLength="20" />

                                <TextBlock Text="验证码"
                                           Foreground="#88FFFFFF"
                                           FontSize="12"
                                           Margin="4,18,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Captcha, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource GhostField}"
                                             MaxLength="8" />
                                    <Button Grid.Column="2"
                                            MinWidth="118"
                                            Content="{Binding SendCaptchaLabel}"
                                            Command="{Binding SendCaptchaCommand}"
                                            IsEnabled="{Binding CanSendCaptcha}"
                                            Style="{StaticResource SoftAction}" />
                                </Grid>

                                <TextBlock Margin="4,10,0,0"
                                           Text="{Binding SmsHint}"
                                           Foreground="#99B8FF4A"
                                           FontSize="12" />

                                <Button Margin="0,28,0,0"
                                        Content="登录"
                                        Command="{Binding LoginWithSmsCommand}"
                                        Style="{StaticResource PrimaryAction}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#66FFFFFF"
                               FontSize="12"
                               Text="仅支持扫码与手机验证码登录" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
