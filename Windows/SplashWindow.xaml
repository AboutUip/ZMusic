<ui:FluentWindow x:Class="ZMusic.SplashWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ZMusic"
                 Width="480"
                 Height="260"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterScreen"
                 Topmost="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 Background="Transparent"
                 Icon="pack://application:,,,/Assets/app-icon.png">
    <Grid>
        <!-- Deep tint so system Acrylic reads as dark glass -->
        <Border Background="#B208080C" />
        <Border Margin="1"
                CornerRadius="12"
                Background="#4D000000"
                BorderBrush="#28FFFFFF"
                BorderThickness="1">
            <Canvas x:Name="LogoCanvas"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    Height="120" />
        </Border>
    </Grid>
</ui:FluentWindow>
