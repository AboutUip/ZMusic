<ui:FluentWindow x:Class="ZMusic.SplashWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ZMusic"
                 Width="520"
                 Height="300"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterScreen"
                 Topmost="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                 Icon="pack://application:,,,/Assets/app-icon.png">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Canvas x:Name="LogoCanvas"
                    HorizontalAlignment="Center"
                    Width="400"
                    Height="100" />
            <StackPanel x:Name="Tagline"
                        Margin="0,10,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="TaglineTranslate" Y="8" />
                </StackPanel.RenderTransform>
                <TextBlock Text="把世界调小一点"
                           FontFamily="Bahnschrift, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Rectangle Width="16"
                           Height="1"
                           Margin="8,0"
                           Fill="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="把歌开大一点"
                           FontFamily="Bahnschrift, Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
