<Window x:Class="ZMusic.Uninstall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载 ZMusic"
        Height="480"
        Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBlack}"
        Foreground="{StaticResource BrushBright}"
        Icon="pack://application:,,,/Assets/app.ico">
  <Border BorderBrush="{StaticResource BrushLine}" BorderThickness="1">
    <Grid>
      <Grid IsHitTestVisible="False">
        <Grid.Background>
          <RadialGradientBrush Center="0.2,0.08" RadiusX="0.9" RadiusY="0.7" GradientOrigin="0.18,0.06">
            <GradientStop Color="#FF1A1A1A" Offset="0" />
            <GradientStop Color="#FF0A0A0A" Offset="0.5" />
            <GradientStop Color="#FF050505" Offset="1" />
          </RadialGradientBrush>
        </Grid.Background>
        <Ellipse x:Name="GlowA"
                 Width="420" Height="420"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-140,-180,0,0"
                 Opacity="0.16">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FFFFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
      </Grid>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#66000000"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid Margin="18,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
              <Image Source="pack://application:,,,/Assets/app-icon.png"
                     Width="20" Height="20"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="ZMusic 卸载"
                         Margin="10,0,0,0"
                         FontFamily="{StaticResource DisplayFont}"
                         FontSize="13"
                         Foreground="{StaticResource BrushSoft}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource CloseButton}"
                    Click="Close_Click" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="40,16,40,8" x:Name="ContentRoot">
          <StackPanel VerticalAlignment="Center">
            <Border Width="56" Height="56" Margin="0,0,0,20"
                    Background="{StaticResource BrushElevated}"
                    BorderBrush="{StaticResource BrushLine}"
                    BorderThickness="1"
                    CornerRadius="14"
                    HorizontalAlignment="Left">
              <Image Source="pack://application:,,,/Assets/app-icon.png"
                     Width="30" Height="30"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <TextBlock Text="卸载 ZMusic"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushWhite}" />
            <TextBlock Margin="0,10,0,22"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Foreground="{StaticResource BrushSoft}"
                       Text="将移除程序文件与快捷方式。登录会话等本地数据默认一并删除，以免账号 Cookie 残留。" />

            <CheckBox x:Name="ClearDataCheck"
                      IsChecked="True"
                      Content="同时删除本地登录数据与缓存（推荐）" />
            <TextBlock x:Name="KeepDataHint"
                       Margin="28,6,0,0"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource BrushMuted}"
                       Visibility="Collapsed"
                       Text="若取消勾选，%LocalAppData%\ZMusic 中的登录态将保留在本机。" />

            <TextBlock x:Name="StatusText"
                       Margin="0,22,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushSoft}" />

            <Grid x:Name="ProgressTrack"
                  Height="3"
                  Margin="0,18,0,0"
                  ClipToBounds="True"
                  Visibility="Collapsed">
              <Border Background="{StaticResource BrushElevated}" CornerRadius="1" />
              <Border x:Name="Sweep"
                      Width="120"
                      HorizontalAlignment="Left"
                      Background="{StaticResource BrushWhite}"
                      CornerRadius="1">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="SweepTransform" X="-120" />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="#99000000"
                BorderBrush="{StaticResource BrushLine}"
                BorderThickness="0,1,0,0"
                Padding="40,16,40,20">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="UninstallButton" Content="卸载" Style="{StaticResource DangerButton}" Click="Uninstall_Click" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
