<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>ZMusic-Silent</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)obj\app-publish\</AppPublishDir>
    <DefineConstants>AppPublishDir=$(AppPublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fragments.wxs" />
    <Compile Include="Package.Silent.wxs" />
  </ItemGroup>

</Project>
