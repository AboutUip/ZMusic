<UserControl x:Class="ZMusic.Setup.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="选择配置" Style="{StaticResource PageTitle}" />
    <TextBlock Style="{StaticResource PageSubtitle}"
               Text="仅用亮度区分选项状态。整机安装会在确认后请求管理员权限。" />

    <TextBlock Text="安装范围" Style="{StaticResource FieldLabel}" />
    <RadioButton x:Name="PerUserRadio" GroupName="Scope"
                 Content="仅当前用户 — 无需管理员"
                 Checked="Scope_Changed" />
    <RadioButton x:Name="PerMachineRadio" GroupName="Scope"
                 Content="整台计算机 — 写入 Program Files，需要 UAC"
                 Margin="0,0,0,22"
                 Checked="Scope_Changed" />

    <TextBlock Text="快捷方式" Style="{StaticResource FieldLabel}" />
    <CheckBox x:Name="DesktopCheck" Content="创建桌面快捷方式"
              Checked="Shortcuts_Changed" Unchecked="Shortcuts_Changed" />
    <CheckBox x:Name="StartMenuCheck" Content="创建开始菜单快捷方式"
              Checked="Shortcuts_Changed" Unchecked="Shortcuts_Changed" />
  </StackPanel>
</UserControl>
