<UserControl x:Class="ZMusic.Setup.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
      <Grid Width="96" Height="96" Margin="0,0,0,28" HorizontalAlignment="Left">
        <Ellipse x:Name="IconHalo" Opacity="0.22">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FFFFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Border Width="72" Height="72"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FF121212"
                BorderBrush="{StaticResource BrushLine}"
                BorderThickness="1"
                CornerRadius="16">
          <Image Source="pack://application:,,,/Assets/app-icon.png"
                 Width="44" Height="44"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
      </Grid>

      <TextBlock Text="ZMusic"
                 Style="{StaticResource DisplayTitle}"
                 FontSize="56" />
      <TextBlock x:Name="VersionText"
                 Margin="0,6,0,0"
                 Foreground="{StaticResource BrushMuted}"
                 FontSize="13" />
      <TextBlock Margin="0,28,0,0"
                 FontSize="20"
                 FontFamily="{StaticResource DisplayFont}"
                 Foreground="{StaticResource BrushWhite}"
                 TextWrapping="Wrap"
                 Text="把世界调小一点。把歌，开大一点。" />
      <TextBlock Margin="0,16,0,0"
                 Style="{StaticResource PageSubtitle}"
                 Text="沉浸安装 Windows 客户端。选择安装范围与路径后，向导将静默完成 MSI 部署。" />
    </StackPanel>
  </Grid>
</UserControl>
