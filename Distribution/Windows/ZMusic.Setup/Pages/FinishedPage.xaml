<UserControl x:Class="ZMusic.Setup.Pages.FinishedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
    <Border Width="56" Height="56" Margin="0,0,0,22"
            Background="{StaticResource BrushElevated}"
            BorderBrush="{StaticResource BrushLine}"
            BorderThickness="1"
            CornerRadius="28"
            HorizontalAlignment="Left">
      <TextBlock x:Name="Glyph"
                 Text="✓"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource BrushWhite}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Border>
    <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
    <TextBlock x:Name="MessageText" Style="{StaticResource PageSubtitle}" />
    <CheckBox x:Name="LaunchCheck"
              Content="安装结束后启动 ZMusic"
              Checked="Launch_Changed"
              Unchecked="Launch_Changed" />
  </StackPanel>
</UserControl>
