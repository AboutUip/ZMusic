<UserControl x:Class="ZMusic.Setup.Pages.LocationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="安装位置" Style="{StaticResource PageTitle}" />
    <TextBlock Style="{StaticResource PageSubtitle}"
               Text="可自定义路径。切换安装范围时会重置为推荐默认目录。" />

    <TextBlock Text="目标文件夹" Style="{StaticResource FieldLabel}" />
    <DockPanel LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="浏览…" Margin="10,0,0,0" Click="Browse_Click" />
      <TextBox x:Name="PathBox"
               Height="40"
               VerticalContentAlignment="Center"
               FontSize="13" />
    </DockPanel>
    <TextBlock x:Name="HintText"
               Margin="0,14,0,0"
               Foreground="{StaticResource BrushMuted}"
               FontSize="12"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
